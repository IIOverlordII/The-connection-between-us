// Cloudflare Workers Builds deploys this on every push to main (npx wrangler deploy)
// and builds a preview for other branches (npx wrangler preview).
// The site is the static app/ folder; the Worker script (worker/index.mjs) runs only for /api/*.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-connection-between-us",
  "compatibility_date": "2026-11-03",
  "main": "worker/index.mjs",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // price of the full version in Paddle (pri_…); /api/unlock stays off until the PADDLE_API_KEY and LICENSE_KEY secrets are set
    "PADDLE_PRICE_ID": "pri_01m6kfbze7fd4qbvatbdrsk0cg"
  },
  // branch previews; the block may stay empty
  "previews": {}
}
